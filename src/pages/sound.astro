---
import Layout from "../layouts/Layout.astro";
import BackButton from "../components/BackButton.astro";
import SoundSample from "../components/SoundSample.astro";
---

<Layout title="Body Synthesis">
  <div class="max-w-screen-md m-auto p-4 my-4 antialiased">
    <h1 class="mb-4 text-3xl font-extrabold leading-tight text-gray-900 lg:mb-6 lg:text-4xl dark:text-white">
      Body Synthesis <br /><span class="text-gradient"
        ></span>
    </h1>

    <SoundSample />
    <br>
    <p class="lead text-white">
      Interactive sound exhibit presented at Aisle Isle in Richmond, VA 9/22/2024.</p>
        <br>
        <p class="text-white">
          Body Synthesis allows the user to add harmonics to a 80 hz tone and separate and recombine these tones using their body. The project uses Google AI Edge's 'Pose Detection Landmark' model to track landmarks of human bodies in a video stream. We connected our Python application to Pure Data using OSC (open sound control) where my collaborator Oscar Muendel created the interactive patch.
        </p>
        <br>
        <p class="mb-6 text-gray-300 md:text-lg">
            <a
            href="https://github.com/hcbryant9/pure-data-body-synthesis"
            target="_blank"
            class="underline inline"
            >GitHub</a>
        </p>
        <p class="mb-6 text-gray-300 md:text-lg">
          <a
          href="https://www.youtube.com/watch?v=3dvjIEdU-Ts"
          target="_blank"
          class="underline inline"
          >Documentation Video</a>
      </p>
        <p class ="text-white">
          Technologies: Python, Pure Data, Open-CV, Networking, Open Sound Control, Mediapipe.<br>
          Collaborators: Oscar Muendel<br>
          Timeline: 08/24-09/24
        </p>

    <BackButton />
</div>
</Layout>

